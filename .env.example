# Copy this file to ".env" (same folder) and fill in your values. NEVER upload .env to GitHub.

PORT=4000
STORE_NAME=PoultryPro
STORE_PHONE=[0306-4888461]
STORE_EMAIL=poultryproequipment83@gmail.com
TIMEZONE=Asia/Karachi

# The address of your website. Used for links inside emails.
# Local testing: http://localhost:5173   Live site: https://your-website.com
SITE_URL=http://localhost:5173

# Secret used to sign login tokens. Use a long random text (30+ characters).
# If empty, the server creates one automatically on first run.
JWT_SECRET=

# ---------- Admin (seller) login at /admin ----------
 

# ---------- WhatsApp button ----------
# Your WhatsApp number with country code, digits only. Example: 923001234567
WHATSAPP_NUMBER=923064888461

# ---------- Login with Google ----------
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID (Web application).
# Add http://localhost:5173 (and your live website address) under "Authorized JavaScript origins".
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# ---------- Emails (order confirmations, new order alerts, message replies) ----------
# Without SMTP the emails are only printed in the server terminal (nothing is sent).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com,
# SMTP_PASS=a 16-letter "App password" (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PoultryPro" <poultryproequipment83@gmail.com>
# New order and new message alerts for you are sent to this address:
# (it uses ADMIN_EMAIL above)

# ---------- OTP by mobile (optional second login method) ----------
# "console" shows the code on screen and in the terminal (testing only). "twilio" sends real SMS.
OTP_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Delivery, tax ----------
DELIVERY_DAYS_MIN=2
DELIVERY_DAYS_MAX=4
# Keep these in sync with src/data/store.js
FREE_SHIPPING_OVER=15000
SHIPPING_FEE=500
TAX_RATE=0
